#!/usr/bin/env python3
"""
omarchy-notification-center
A GTK4 + layer-shell notification center for Omarchy/Mako.

- Reads notification history from makoctl history
- Reads theme colors from ~/.config/omarchy/current/theme/waybar.css
- Displays as a floating layer-shell panel (top-right)
- Toggle: running again while open closes the existing window
"""

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")

from gi.repository import Gtk, GLib, Pango, Gdk
from gi.repository import Gtk4LayerShell as LayerShell

import subprocess
import os
import re
import sys
import signal

# ── Toggle: kill existing instance ─────────────────────────────────────────
LOCK_FILE = "/tmp/omarchy-notification-center.pid"


def kill_existing():
    """Kill any running notification center. Returns True if one was killed."""
    if os.path.exists(LOCK_FILE):
        try:
            with open(LOCK_FILE) as f:
                pid = int(f.read().strip())
            if pid != os.getpid():
                os.kill(pid, signal.SIGTERM)
                os.remove(LOCK_FILE)
                return True
        except (ProcessLookupError, ValueError, OSError):
            try:
                os.remove(LOCK_FILE)
            except OSError:
                pass
    return False


def write_lock():
    with open(LOCK_FILE, "w") as f:
        f.write(str(os.getpid()))


def cleanup_lock():
    try:
        os.remove(LOCK_FILE)
    except OSError:
        pass


# ── Theme color extraction ──────────────────────────────────────────────────
THEME_CSS = os.path.expanduser("~/.config/omarchy/current/theme/waybar.css")
COLORS_TOML = os.path.expanduser("~/.config/omarchy/current/theme/colors.toml")


def parse_theme_colors():
    """Extract color values from colors.toml and waybar.css."""
    colors = {
        "foreground": "#e0e0e0",
        "background": "#1a1a2e",
        "accent": "#7aa2f7",
    }

    # Try colors.toml first (more complete)
    if os.path.exists(COLORS_TOML):
        try:
            with open(COLORS_TOML) as f:
                for line in f:
                    line = line.strip()
                    if line.startswith("#") or "=" not in line:
                        continue
                    key, _, val = line.partition("=")
                    key = key.strip()
                    val = val.strip().strip('"').strip("'")
                    if key in colors and val.startswith("#"):
                        colors[key] = val
        except OSError:
            pass

    # Fallback: waybar.css
    if os.path.exists(THEME_CSS):
        pattern = re.compile(r'@define-color\s+(\w+)\s+(#[0-9a-fA-F]{3,8});')
        try:
            with open(THEME_CSS) as f:
                for line in f:
                    m = pattern.search(line)
                    if m and m.group(1) in colors and colors[m.group(1)].startswith("#1a"):
                        colors[m.group(1)] = m.group(2)
        except OSError:
            pass

    return colors


def is_dark(hex_color):
    try:
        h = hex_color.lstrip("#")
        if len(h) == 3:
            h = "".join(c * 2 for c in h)
        r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
        return (0.299 * r + 0.587 * g + 0.114 * b) / 255 < 0.5
    except Exception:
        return True


# ── Notification history ────────────────────────────────────────────────────

def parse_history_text(text):
    """Parse makoctl history text output into list of dicts."""
    notifications = []
    current = None

    for line in text.strip().split("\n"):
        if not line:
            continue

        # "Notification N: Summary text"
        m = re.match(r"^Notification\s+(\d+):\s*(.*)", line)
        if m:
            if current is not None:
                notifications.append(current)
            current = {
                "id": int(m.group(1)),
                "summary": m.group(2).strip(),
                "app-name": "",
                "body": "",
                "urgency": "normal",
            }
            continue

        if current is None:
            continue

        stripped = line.strip()
        if stripped.startswith("App name:"):
            current["app-name"] = stripped[len("App name:"):].strip()
        elif stripped.startswith("Body:"):
            current["body"] = stripped[len("Body:"):].strip()
        elif stripped.startswith("Urgency:"):
            current["urgency"] = stripped[len("Urgency:"):].strip()

    if current is not None:
        notifications.append(current)

    return list(reversed(notifications))  # newest first


def get_history():
    """Return list of notification dicts from makoctl history."""
    try:
        result = subprocess.run(
            ["makoctl", "history"],
            capture_output=True, text=True, timeout=3
        )
        if result.returncode != 0 or not result.stdout.strip():
            return []
        return parse_history_text(result.stdout)
    except Exception:
        return []


def clear_all_notifications():
    """Dismiss all active popups and clear all notifications from mako history."""
    try:
        subprocess.run(["makoctl", "dismiss", "-a", "-h"], capture_output=True, timeout=2)
        for _ in range(150):
            res = subprocess.run(["makoctl", "history"], capture_output=True, text=True, timeout=2)
            if not res.stdout or "Notification" not in res.stdout:
                break
            subprocess.run(["makoctl", "restore"], capture_output=True, timeout=1)
            subprocess.run(["makoctl", "dismiss", "-a", "-h"], capture_output=True, timeout=1)
    except Exception:
        pass


def dismiss_single_notification(notif_id):
    """Remove a specific notification from mako history."""
    if notif_id is None:
        return
    try:
        # Check if in history
        hist = subprocess.run(["makoctl", "history"], capture_output=True, text=True, timeout=2)
        if f"Notification {notif_id}:" in hist.stdout:
            # Restore all items to active
            for _ in range(150):
                h_check = subprocess.run(["makoctl", "history"], capture_output=True, text=True, timeout=2)
                if not h_check.stdout or "Notification" not in h_check.stdout:
                    break
                subprocess.run(["makoctl", "restore"], capture_output=True, timeout=1)

            # Dismiss the targeted ID without history
            subprocess.run(["makoctl", "dismiss", "-n", str(notif_id), "-h"], capture_output=True, timeout=1)

            # Put remaining active notifications back into history
            subprocess.run(["makoctl", "dismiss", "-a"], capture_output=True, timeout=1)
        else:
            # If active, dismiss without adding to history
            subprocess.run(["makoctl", "dismiss", "-n", str(notif_id), "-h"], capture_output=True, timeout=1)
    except Exception:
        pass



# ── Build themed CSS ────────────────────────────────────────────────────────
def _hex_to_rgb(h):
    h = h.lstrip("#")
    if len(h) == 3:
        h = "".join(c * 2 for c in h)
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def _rgb_to_hex(r, g, b):
    return f"#{int(r):02x}{int(g):02x}{int(b):02x}"


def _lighten(hex_color, amount):
    try:
        r, g, b = _hex_to_rgb(hex_color)
        return _rgb_to_hex(min(255, r + 255 * amount),
                           min(255, g + 255 * amount),
                           min(255, b + 255 * amount))
    except Exception:
        return hex_color


def _darken(hex_color, amount):
    try:
        r, g, b = _hex_to_rgb(hex_color)
        return _rgb_to_hex(max(0, r - 255 * amount),
                           max(0, g - 255 * amount),
                           max(0, b - 255 * amount))
    except Exception:
        return hex_color


def _blend(hex_a, hex_b, t):
    try:
        r1, g1, b1 = _hex_to_rgb(hex_a)
        r2, g2, b2 = _hex_to_rgb(hex_b)
        return _rgb_to_hex(r1 * (1 - t) + r2 * t,
                           g1 * (1 - t) + g2 * t,
                           b1 * (1 - t) + b2 * t)
    except Exception:
        return hex_a


def build_css(colors):
    fg = colors.get("foreground", "#e0e0e0")
    bg = colors.get("background", "#1a1a2e")
    accent = colors.get("accent", "#7aa2f7")
    dark = is_dark(bg)

    if dark:
        surface = _lighten(bg, 0.07)
        surface2 = _lighten(bg, 0.13)
        divider = _lighten(bg, 0.16)
        muted_fg = _blend(fg, bg, 0.45)
    else:
        surface = _darken(bg, 0.06)
        surface2 = _darken(bg, 0.11)
        divider = _darken(bg, 0.14)
        muted_fg = _blend(fg, bg, 0.45)

    return f"""
