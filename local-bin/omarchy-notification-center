# ── Notification row widget ─────────────────────────────────────────────────
def make_notification_row(notif, on_dismiss):
    app_name = str(notif.get("app-name", "Unknown"))
    summary = str(notif.get("summary", ""))
    body = str(notif.get("body", ""))
    urgency = str(notif.get("urgency", "normal"))
    notif_id = notif.get("id")

    # Strip markup tags
    body_plain = re.sub(r"<[^>]+>", "", body).strip()

    outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    outer.add_css_class("nc-notification")
    if urgency == "critical":
        outer.add_css_class("nc-urgency-critical")
    elif urgency == "low":
        outer.add_css_class("nc-urgency-low")

    content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3)
    content.set_hexpand(True)

    if app_name:
        app_label = Gtk.Label(label=f"  {app_name.upper()}", xalign=0)
        app_label.add_css_class("nc-app-name")
        app_label.set_ellipsize(Pango.EllipsizeMode.END)
        content.append(app_label)

    if summary:
        sum_label = Gtk.Label(label=summary, xalign=0)
        sum_label.add_css_class("nc-summary")
        sum_label.set_ellipsize(Pango.EllipsizeMode.END)
        content.append(sum_label)

    if body_plain:
        body_label = Gtk.Label(label=body_plain, xalign=0)
        body_label.add_css_class("nc-body")
        body_label.set_ellipsize(Pango.EllipsizeMode.END)
        body_label.set_max_width_chars(44)
        body_label.set_wrap(True)
        body_label.set_wrap_mode(Pango.WrapMode.WORD_CHAR)
        body_label.set_lines(2)
        content.append(body_label)

    outer.append(content)

    dismiss_btn = Gtk.Button(label="✕")
    dismiss_btn.add_css_class("nc-dismiss-btn")
    dismiss_btn.set_valign(Gtk.Align.START)
    dismiss_btn.connect("clicked", lambda _: on_dismiss(notif_id, outer))
    outer.append(dismiss_btn)

    return outer



# ── Main Window ─────────────────────────────────────────────────────────────
class NotificationCenter(Gtk.ApplicationWindow):
    def __init__(self, app, colors):
        super().__init__(application=app, title="Notification Center")
        self._colors = colors

        # Layer shell setup
        LayerShell.init_for_window(self)
        LayerShell.set_layer(self, LayerShell.Layer.OVERLAY)
        LayerShell.set_anchor(self, LayerShell.Edge.TOP, True)
        LayerShell.set_anchor(self, LayerShell.Edge.RIGHT, True)
        LayerShell.set_margin(self, LayerShell.Edge.TOP, 30)
        LayerShell.set_margin(self, LayerShell.Edge.RIGHT, 10)
        LayerShell.set_keyboard_mode(self, LayerShell.KeyboardMode.ON_DEMAND)
        self.set_default_size(360, -1)

        # Apply CSS
        provider = Gtk.CssProvider()
        provider.load_from_string(build_css(colors))
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

        self._build_ui()
        self._load_notifications()

        # Close on Escape
        key_ctrl = Gtk.EventControllerKey()
        key_ctrl.connect("key-pressed", self._on_key)
        self.add_controller(key_ctrl)

        # Close when focus lost
        self.connect("notify::is-active", self._on_focus_changed)
        self._just_opened = True
        GLib.timeout_add(500, self._clear_just_opened)

    def _clear_just_opened(self):
        self._just_opened = False
        return False

    def _build_ui(self):
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_child(root)

        # Header
        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        header.add_css_class("nc-header")

        title = Gtk.Label(label="󰂚  Notifications")
        title.add_css_class("nc-title")
        title.set_hexpand(True)
        title.set_xalign(0)
        header.append(title)

        self._count_label = Gtk.Label(label="")
        self._count_label.add_css_class("nc-count")
        header.append(self._count_label)

        clear_btn = Gtk.Button(label="Clear All")
        clear_btn.add_css_class("nc-clear-btn")
        clear_btn.connect("clicked", self._on_clear_all)
        header.append(clear_btn)

        root.append(header)

        # Scrollable list
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroll.set_max_content_height(540)
        scroll.set_propagate_natural_height(True)
        scroll.add_css_class("nc-scroll")
        root.append(scroll)

        self._list_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        self._list_box.add_css_class("nc-list")
        self._list_box.set_margin_top(6)
        self._list_box.set_margin_bottom(8)
        scroll.set_child(self._list_box)

        # Empty state
        self._empty_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self._empty_box.add_css_class("nc-empty-box")
        self._empty_label = Gtk.Label(label="󰂜  No notifications")
        self._empty_label.add_css_class("nc-empty")
        self._empty_label.set_halign(Gtk.Align.CENTER)
        self._empty_box.append(self._empty_label)
        self._list_box.append(self._empty_box)

    def _load_notifications(self):
        # Remove all rows except empty state
        child = self._list_box.get_first_child()
        to_remove = []
        while child:
            next_child = child.get_next_sibling()
            if child != self._empty_box:
                to_remove.append(child)
            child = next_child
        for row in to_remove:
            self._list_box.remove(row)

        notifications = get_history()
        count = len(notifications)

        if count == 0:
            self._empty_box.set_visible(True)
            self._count_label.set_label("")
        else:
            self._empty_box.set_visible(False)
            self._count_label.set_label(f"{count}")
            for notif in notifications:
                row = make_notification_row(notif, self._on_dismiss_row)
                self._list_box.append(row)

    def _on_dismiss_row(self, notif_id, row_widget):
        dismiss_single_notification(notif_id)
        self._list_box.remove(row_widget)
        self._update_count()


    def _update_count(self):
        count = 0
        child = self._list_box.get_first_child()
        while child:
            if child != self._empty_box:
                count += 1
            child = child.get_next_sibling()
        if count == 0:
            self._empty_box.set_visible(True)
            self._count_label.set_label("")
        else:
            self._count_label.set_label(f"{count}")

    def _on_clear_all(self, _btn):
        clear_all_notifications()
        child = self._list_box.get_first_child()
        to_remove = []
        while child:
            next_child = child.get_next_sibling()
            if child != self._empty_box:
                to_remove.append(child)
            child = next_child
        for row in to_remove:
            self._list_box.remove(row)
        self._empty_box.set_visible(True)
        self._count_label.set_label("")

    def _on_key(self, ctrl, keyval, keycode, state):
        if keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def _on_focus_changed(self, win, param):
        if self._just_opened:
            return
        if not self.get_property("is-active"):
            GLib.timeout_add(200, self._check_close)

    def _check_close(self):
        if not self.get_property("is-active"):
            self.close()
        return False


# ── Application ─────────────────────────────────────────────────────────────
class NotificationCenterApp(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.omarchy.NotificationCenter")

    def do_activate(self):
        colors = parse_theme_colors()
        win = NotificationCenter(self, colors)
        write_lock()
        win.connect("destroy", lambda _: cleanup_lock())
        win.present()


def main():
    if kill_existing():
        sys.exit(0)

    app = NotificationCenterApp()
    signal.signal(signal.SIGTERM, lambda s, f: (cleanup_lock(), sys.exit(0)))
    sys.exit(app.run(None))


if __name__ == "__main__":
    main()
