    background-color: transparent;
    color: {accent};
    border: 1px solid {accent};
    border-radius: 5px;
    padding: 3px 10px;
    font-family: 'JetBrainsMono Nerd Font', 'JetBrains Mono', monospace;
    font-size: 11px;
}}

